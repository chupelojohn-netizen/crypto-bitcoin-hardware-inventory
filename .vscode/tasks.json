{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build ecommerce",
      "type": "shell",
      "command": "${env:USERPROFILE}\\Documents\\Codex\\toolchains\\w64devkit\\bin\\g++.exe",
      "args": [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-pedantic",
        "${workspaceFolder}/main.cpp",
        "${workspaceFolder}/inventory_features.cpp",
        "${workspaceFolder}/checkout_actions.cpp",
        "-o",
        "${workspaceFolder}/ecommerce"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "args": [
          "-std=c++17",
          "-Wall",
          "-Wextra",
          "-pedantic",
          "${workspaceFolder}/main.cpp",
          "${workspaceFolder}/inventory_features.cpp",
          "${workspaceFolder}/checkout_actions.cpp",
          "-o",
          "${workspaceFolder}/ecommerce.exe"
        ]
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
